b:Te69,{"@context":"https://schema.org","@type":"Service","name":"Création et gestion de site internet pour professionnels","serviceType":"Création, hébergement et maintenance de site vitrine","url":"https://webvibes.fr/tarifs","provider":{"@type":"Organization","name":"WebVibes","url":"https://webvibes.fr"},"areaServed":{"@type":"Country","name":"France"},"audience":{"@type":"BusinessAudience","audienceType":"Restaurants et professionnels de la restauration"},"hasOfferCatalog":{"@type":"OfferCatalog","name":"Formules WebVibes","itemListElement":[{"@type":"Offer","name":"Essentiel","description":"Pour être trouvé et joignable. Site jusqu'à 3 pages : accueil, carte, infos pratiques. Carte, horaires, plan d'accès, bouton d'appel. Réservation par téléphone ou lien vers votre outil actuel. Référencement de base : optimisation technique, vitesse, balises. 1 modification de contenu par mois.","url":"https://webvibes.fr/tarifs","priceCurrency":"EUR","priceSpecification":[{"@type":"UnitPriceSpecification","name":"Abonnement mensuel, engagement 12 mois","price":89,"priceCurrency":"EUR","valueAddedTaxIncluded":false,"referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitCode":"MON"}},{"@type":"UnitPriceSpecification","name":"Abonnement mensuel sans engagement","price":99,"priceCurrency":"EUR","valueAddedTaxIncluded":false,"referenceQuantity":{"@type":"QuantitativeValue","value":1,"unitCode":"MON"}},{"@type":"PriceSpecification","name":"Création et mise en ligne (une seule fois)","price":390,"priceCurrency":"EUR","valueAddedTaxIncluded":false}]},{"@type":"Offer","name":"Standard","description":"Pour remplir la salle grâce à Google. Tout l'Essentiel, avec un site jusqu'à 5 pages et une galerie photos. Formulaire de demande de réservation. Création ou optimisation de votre fiche Google. Référencement local : votre cuisine + votre ville. Vos avis Google mis en avant sur le site. 2 modifications de contenu par mois.","url":"https://webvibes.fr/tarifs","priceCurrency":"EUR